{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "required": [
    "meta",
    "style",
    "references",
    "shots",
    "music",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title_am",
        "title_en",
        "language",
        "fps",
        "target_duration_s",
        "formats",
        "default_seed"
      ],
      "additionalProperties": false,
      "properties": {
        "title_am": {
          "type": "string",
          "minLength": 1
        },
        "title_en": {
          "type": "string",
          "minLength": 1
        },
        "logline": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP-47 tag of the narration, e.g. am-ET"
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30
          ]
        },
        "target_duration_s": {
          "type": "number",
          "minimum": 60,
          "maximum": 90
        },
        "formats": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "9:16",
              "16:9"
            ]
          },
          "uniqueItems": true
        },
        "default_seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "style_block",
        "negative",
        "voice"
      ],
      "additionalProperties": false,
      "properties": {
        "style_block": {
          "type": "string",
          "description": "Appended to every keyframe prompt to prevent drift"
        },
        "negative": {
          "type": "string",
          "description": "Things every keyframe must avoid"
        },
        "voice": {
          "type": "object",
          "required": [
            "model",
            "voice_name",
            "style_instruction"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string"
            },
            "voice_name": {
              "type": "string"
            },
            "style_instruction": {
              "type": "string"
            },
            "fallback_models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tried in order when the primary model is rate-limited or over quota"
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "description",
          "prompt",
          "seed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "object",
              "place",
              "style"
            ]
          },
          "description": {
            "type": "string",
            "description": "Fixed text re-used verbatim in every shot that uses this reference"
          },
          "prompt": {
            "type": "string"
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "reason",
          "shot_size",
          "min_duration_s",
          "keyframe",
          "motion",
          "narration"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2}$"
          },
          "beat": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this shot exists"
          },
          "shot_size": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "medium_close",
              "close_up",
              "extreme_close",
              "insert"
            ]
          },
          "min_duration_s": {
            "type": "number",
            "minimum": 3,
            "maximum": 15,
            "description": "Final length is max(this, narration length + padding)"
          },
          "keyframe": {
            "type": "object",
            "required": [
              "prompt",
              "refs",
              "seed"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 10
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "text_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "References used as text description only (no image conditioning), e.g. to avoid copying a front-facing reference pose"
              }
            }
          },
          "motion": {
            "type": "object",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "wan",
                  "kenburns",
                  "still"
                ]
              },
              "prompt": {
                "type": "string",
                "description": "Motion and camera only; the image already holds the subject"
              },
              "kenburns": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "zoom_from": {
                    "type": "number",
                    "minimum": 1.0,
                    "maximum": 1.5
                  },
                  "zoom_to": {
                    "type": "number",
                    "minimum": 1.0,
                    "maximum": 1.5
                  },
                  "pan": {
                    "type": "string",
                    "enum": [
                      "none",
                      "left",
                      "right",
                      "up",
                      "down"
                    ]
                  }
                }
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "wan"
                    }
                  }
                },
                "then": {
                  "required": [
                    "prompt"
                  ]
                }
              }
            ]
          },
          "narration": {
            "type": "object",
            "required": [
              "text",
              "subtitle_en"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "description": "Narration in meta.language; empty string for a silent shot"
              },
              "subtitle_en": {
                "type": "string"
              },
              "style_instruction": {
                "type": "string",
                "description": "Overrides style.voice.style_instruction for this line"
              }
            }
          },
          "title_overlay": {
            "type": "string",
            "description": "Text added in code (never inside the generated image)"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "required": [
        "model",
        "caption",
        "instrumental",
        "bpm",
        "key",
        "duration_s",
        "candidates",
        "cues",
        "duck"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "instrumental": {
          "type": "boolean"
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 30,
          "maximum": 120
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "chosen": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Index of the chosen candidate; see EXPERIMENTS.md"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_shot",
              "intent"
            ],
            "additionalProperties": false,
            "properties": {
              "at_shot": {
                "type": "string",
                "pattern": "^s[0-9]{2}$"
              },
              "intent": {
                "type": "string"
              }
            }
          }
        },
        "duck": {
          "type": "object",
          "required": [
            "threshold",
            "ratio",
            "attack_ms",
            "release_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "text_en",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "text_am": {
          "type": "string"
        },
        "text_en": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 5
        }
      }
    }
  }
}